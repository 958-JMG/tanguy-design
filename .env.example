# Tanguy Design — Cockpit (env vars)
# Copier en `.env` et remplir. Ne JAMAIS commiter `.env`.

# --- Runtime ---
PORT=3000
# NODE_ENV=production en prod Scaleway (le container l'injecte déjà via Dockerfile)
# NODE_ENV=production

# --- Sessions ---
# Générer avec : openssl rand -hex 32
# En prod, le serveur refuse de démarrer si SESSION_SECRET manque, vaut la valeur par défaut, ou < 32 chars.
SESSION_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32

# --- Airtable ---
# Token avec scopes : data.records:read/write + schema.bases:read/write (pour scripts/setup-attachment-fields.js)
AIRTABLE_KEY=patXXXX.XXXX
AIRTABLE_BASE_ID=appXXXX

# --- Claude / Anthropic (parsing devis Winner + Plaud) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Users ---
# Format : login:bcrypthash,login:bcrypthash,...
# Génère un hash : `node scripts/hash-password.js MonMotDePasse`
# Alternative base64 (CSV peut poser problème dans certaines UI) : USERS_HASHES_B64=<base64 de la chaîne>
USERS_HASHES=virginie:$2b$10$xxx,solene:$2b$10$yyy,sebastien:$2b$10$zzz,marine:$2b$10$www

# --- Rôles admin ---
# CSV en lowercase. Les users listés ici voient le menu Admin (Marges + Stock). Défaut : virginie.
ADMIN_LOGINS=virginie

# --- URL PDF server (si utilisé via api-pdf.958.fr, uniquement cockpit Barbier) ---
# PDF_SERVER_URL=https://api-pdf.958.fr
